# ───────── Bắt buộc ─────────
# Chuỗi bí mật >= 32 ký tự, dùng để mã hóa token của các dịch vụ kết nối.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Mã thiết lập: trang /setup chỉ tạo tài khoản chủ sở hữu khi nhập đúng mã này.
# Trên server thật BẮT BUỘC phải đặt, nếu không trang /setup bị khóa. Tạo nhanh bằng lệnh như APP_SECRET ở trên.
# Máy cá nhân (npm run dev) có thể để trống.
SETUP_TOKEN=

# Tên miền trỏ về VPS, dùng cho Caddy tự lấy chứng chỉ HTTPS (chỉ cần khi chạy bằng docker compose).
# Chưa có tên miền: dùng dạng <IP-có-dấu-gạch>.sslip.io, ví dụ 203-0-113-5.sslip.io
DOMAIN=

# ───────── Database ─────────
# Để trống → dùng PGlite (Postgres nhúng, lưu ở .data/pglite) — hợp cho máy cá nhân.
# Khi lên server: điền chuỗi kết nối PostgreSQL, ví dụ:
# DATABASE_URL=postgres://workhub:matkhau@localhost:5432/workhub
DATABASE_URL=
# Chỉ dùng khi chạy bằng docker-compose (mật khẩu cho container Postgres)
POSTGRES_PASSWORD=

# ───────── AI ─────────
# Chỉ cần điền key của hãng bạn dùng. Model mặc định có thể đổi ngay trên giao diện.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5-mini

GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# Hãng dùng cho việc chạy nền (bản tin tự động) và khi giao diện chưa chọn: openai | gemini
AI_DEFAULT_PROVIDER=

# ───────── Bản tin sáng / Tổng kết tuần ─────────
# Tự tạo khi app đang chạy. Đặt BRIEF_AUTO=off để tắt.
BRIEF_AUTO=on
BRIEF_HOUR=7
# 0 = Chủ nhật, 1 = Thứ 2, ... 6 = Thứ 7
WEEKLY_REVIEW_DAY=1
# Chỉ cần khi chạy kiểu serverless (Vercel): gọi GET /api/cron/brief với header "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Múi giờ để tính "hôm nay", "7h sáng"... (quan trọng khi chạy trên VPS)
TZ=Asia/Ho_Chi_Minh

# ───────── Kết nối dịch vụ ngoài (điền khi bắt đầu làm từng kết nối) ─────────
# Google (Calendar, Gmail, Drive, YouTube) — tạo OAuth client tại console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Notion — tạo integration tại notion.so/my-integrations
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Telegram bot — nhắn @BotFather, gửi /newbot để lấy token. Liên kết chat ở trang Kết nối trong app.
TELEGRAM_BOT_TOKEN=
# Mỗi bot chỉ chạy được ở MỘT nơi. Nếu vừa chạy trên máy cá nhân vừa trên VPS, đặt off ở máy cá nhân.
TELEGRAM_POLLING=on
# Địa chỉ app, để bot gửi kèm link mở mục vừa ghi (trên VPS tự lấy từ DOMAIN nếu để trống)
APP_URL=
